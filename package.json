{
  "name": "personal-blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "个人博客：Markdown 写作、分类归档、一键转微信公众号、GitHub Pages 部署",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/export-wechat.mjs",
    "build:site": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "wechat": "npm run build:site && node scripts/export-wechat.mjs",
    "new": "node scripts/new-post.mjs",
    "test:wechat": "node scripts/wechat-smoke-test.mjs",
    "build:clean": "rm -rf .astro dist node_modules/.astro && npm run build",
    "audit": "node scripts/taste-audit.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tabler/icons": "^3.46.0",
    "astro": "^7.3.2",
    "cheerio": "^1.2.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "juice": "^11.0.1",
    "temml": "^0.13.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
